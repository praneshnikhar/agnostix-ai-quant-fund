# =============================================================================
# AI Quant Fund — Environment Configuration (M0)
# Copy to `.env` and fill in values. NEVER commit the real `.env`.
# =============================================================================

# --- Application ---
API_ENVIRONMENT=dev
API_DEBUG=true
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL ---
POSTGRES_USER=fund
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=fund
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_DATABASE_URL=postgresql+asyncpg://fund:change-me-local-only@localhost:5432/fund

# --- Redis ---
API_REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Model Gateway (all optional; gateway works with whichever is set) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# --- Alpaca (PAPER TRADING ONLY — server-side, never exposed to frontend) ---
# The API reads these with the API_ prefix (see app/core/config.py). For the
# trading desk + options broker, set API_ALPACA_API_KEY / API_ALPACA_SECRET_KEY.
API_ALPACA_API_KEY=
API_ALPACA_SECRET_KEY=
API_ALPACA_PAPER=true
# Optional: Alpaca MCP server endpoint (development accelerator; SDK/API is the fallback)
API_ALPACA_MCP_URL=
# Legacy names used by the M1 market-data adapter (kept for compatibility).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Auth foundation (M0 scaffolding) ---
AUTH_SECRET=generate-a-long-random-string
# Fernet key generated with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_PROVIDER_ENCRYPTION_KEY=
